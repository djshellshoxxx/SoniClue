{
  "$id": "https://circuitdriftlabs.example/sonicclue/schemas/bridge_hello-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "axes": {
      "maximum": 3,
      "minimum": 1,
      "title": "Axes",
      "type": "integer"
    },
    "device_model": {
      "maxLength": 32,
      "title": "Device Model",
      "type": "string"
    },
    "firmware_version": {
      "maxLength": 32,
      "title": "Firmware Version",
      "type": "string"
    },
    "full_scale_g": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Full Scale G",
      "type": "number"
    },
    "protocol_version": {
      "maximum": 255,
      "minimum": 1,
      "title": "Protocol Version",
      "type": "integer"
    },
    "sample_rate_hz": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "title": "Sample Rate Hz",
      "type": "number"
    },
    "type": {
      "const": "hello",
      "default": "hello",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "device_model",
    "firmware_version",
    "sample_rate_hz",
    "axes",
    "full_scale_g"
  ],
  "title": "BridgeHello",
  "type": "object"
}
