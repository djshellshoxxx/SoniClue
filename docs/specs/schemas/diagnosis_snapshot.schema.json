{
  "$defs": {
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "channel_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Label"
        },
        "freq_hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freq Hz"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "statement_class": {
          "$ref": "#/$defs/StatementClass"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "valid": {
          "default": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "statement_class",
        "summary"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "tone",
        "harmonic_family",
        "mains_harmonics",
        "state_effect",
        "no_state_effect",
        "residual_after_off",
        "structural_coherence",
        "airborne_control",
        "resonance",
        "transients",
        "position_gradient",
        "intervention_effect",
        "confounded_intervention",
        "not_comparable",
        "measurement_quality",
        "alias_test",
        "chain_noise_test",
        "user_observation"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/HypothesisCategory"
        },
        "contradicting": {
          "items": {
            "type": "string"
          },
          "title": "Contradicting",
          "type": "array"
        },
        "explanation": {
          "items": {
            "type": "string"
          },
          "title": "Explanation",
          "type": "array"
        },
        "freq_hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freq Hz"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/SupportLevel"
        },
        "missing_tests": {
          "items": {
            "type": "string"
          },
          "title": "Missing Tests",
          "type": "array"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "supporting": {
          "items": {
            "type": "string"
          },
          "title": "Supporting",
          "type": "array"
        }
      },
      "required": [
        "id",
        "category",
        "subject",
        "statement",
        "level"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "HypothesisCategory": {
      "enum": [
        "source",
        "additional_source",
        "structural_path",
        "airborne_path",
        "resonance",
        "rattle",
        "electrical_hum",
        "recording_chain",
        "measurement_artifact"
      ],
      "title": "HypothesisCategory",
      "type": "string"
    },
    "NextTest": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "difficulty": {
          "maximum": 3,
          "minimum": 1,
          "title": "Difficulty",
          "type": "integer"
        },
        "discriminates": {
          "items": {
            "type": "string"
          },
          "title": "Discriminates",
          "type": "array"
        },
        "pairs_separated": {
          "minimum": 0,
          "title": "Pairs Separated",
          "type": "integer"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Params",
          "type": "object"
        },
        "procedure_id": {
          "title": "Procedure Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unavailable_reason": {
          "default": "",
          "title": "Unavailable Reason",
          "type": "string"
        }
      },
      "required": [
        "procedure_id",
        "title",
        "reason",
        "pairs_separated",
        "difficulty",
        "available"
      ],
      "title": "NextTest",
      "type": "object"
    },
    "StatementClass": {
      "enum": [
        "measured",
        "calculated",
        "inferred",
        "user_asserted",
        "unresolved"
      ],
      "title": "StatementClass",
      "type": "string"
    },
    "SupportLevel": {
      "enum": [
        "strongly_supported",
        "supported",
        "undetermined",
        "weakened",
        "contradicted"
      ],
      "title": "SupportLevel",
      "type": "string"
    }
  },
  "$id": "https://circuitdriftlabs.example/sonicclue/schemas/diagnosis_snapshot-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "abstention_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Abstention Reasons",
      "type": "array"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "conclusion": {
      "enum": [
        "leading_explanation",
        "multiple_explanations",
        "inconclusive"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "created_utc": {
      "format": "date-time",
      "title": "Created Utc",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "next_tests": {
      "items": {
        "$ref": "#/$defs/NextTest"
      },
      "title": "Next Tests",
      "type": "array"
    },
    "ruleset_version": {
      "title": "Ruleset Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "case_id",
    "created_utc",
    "ruleset_version",
    "conclusion",
    "evidence",
    "hypotheses",
    "next_tests"
  ],
  "title": "DiagnosisSnapshot",
  "type": "object"
}
